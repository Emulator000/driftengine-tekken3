node_modules/
dist/
# The Android build (`npm run android`): it carries the disc's data.
out/
*.apk
*.aab
*.jks
*.keystore
*.log
.playwright-mcp/

# The disc image and everything extracted from it. The game's content, never committed.
.cache/

# What `npm run extract` and `npm run import` write from the disc. Converted content is still the
# game's content, whatever its format.
public/data/
public/assets/
local-remaster/

# Local configuration.
.env
.env.*

# Disc images, archives and the game's own file types, so none can be added by accident.
*.bin
*.cue
*.iso
*.img
*.ecm
*.chd
*.pbp
*.mdf
*.mds
*.ccd
*.sub
*.7z
*.zip
*.rar
*.exe
*.elf
*.irx
*.BNS
*.XAS
*.STR
*.xa
*.vab
*.vh
*.vb
*.tim
*.tmd
*.3dmk
*.pcm
SL?S_*.*

# Arcade board dumps: chip files as they are usually named and joined images, so none can be added
# by accident. What `npm run arcade` joins stays in .cache/arcade/.
*.rom
*.ic[0-9]
*.ic[0-9][0-9]
*.[0-9]
*.[0-9][0-9]
*.[0-9][a-z]
*.[0-9][0-9][a-z]

# Python bytecode
__pycache__/

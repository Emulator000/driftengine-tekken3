#!/bin/sh
# The remaster's Python: the one made for the device REMASTER_DEVICE names (rocm, cuda or cpu), else
# a GPU's PyTorch where one is installed (AMD's, then NVIDIA's), else the CPU's.
here=$(cd "$(dirname "$0")/../.." && pwd)
unset LD_LIBRARY_PATH
# ROCm picks its kernels quickly rather than timing every one the first time it meets a shape.
export MIOPEN_FIND_MODE=FAST
case "$REMASTER_DEVICE" in
  rocm) exec "$here/.cache/remaster/py-rocm/bin/python" -I "$@" ;;
  cuda) exec "$here/.cache/remaster/py-cuda/bin/python" -I "$@" ;;
  cpu) exec "$here/.cache/remaster/py/bin/python" -I "$@" ;;
esac
if [ -x "$here/.cache/remaster/py-rocm/bin/python" ]; then exec "$here/.cache/remaster/py-rocm/bin/python" -I "$@"; fi
if [ -x "$here/.cache/remaster/py-cuda/bin/python" ]; then exec "$here/.cache/remaster/py-cuda/bin/python" -I "$@"; fi
exec "$here/.cache/remaster/py/bin/python" -I "$@"

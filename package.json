{
  "name": "driftengine-tekken3",
  "version": "0.7.17",
  "description": "Unofficial: Tekken 3 rebuilt on DriftEngine from the data of a user's own disc. No game files included.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "scripts": {
    "disc": "node scripts/disc.mjs",
    "extract": "node scripts/extract.mjs",
    "t4": "node scripts/t4-data.mjs",
    "arcade": "node scripts/arcade.mjs",
    "import": "node scripts/import.mjs",
    "remaster": "node scripts/remaster.mjs",
    "music": "node scripts/music.mjs",
    "relay": "node server/relay.mjs",
    "predev": "node scripts/extract.mjs --if-missing && node scripts/import.mjs --if-missing",
    "dev": "vite",
    "predev:lan": "node scripts/extract.mjs --if-missing && node scripts/import.mjs --if-missing",
    "dev:lan": "vite --mode lan",
    "desktop": "node scripts/app.mjs",
    "android": "node scripts/app.mjs android",
    "ios": "node scripts/app.mjs ios",
    "prebuild": "npm test",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && npm run typecheck"
  },
  "dependencies": {
    "@driftengine/audio": "^4.14.3",
    "@driftengine/core": "^4.14.3",
    "@driftengine/network": "^4.14.3",
    "@driftengine/ui2d": "^4.14.3",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/saira-extra-condensed": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.9.0",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
